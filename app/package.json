{
  "name": "tdqsys-v2-desktop",
  "productName": "TDQSYS v2",
  "version": "2.0.2",
  "description": "TDQSYS - desktop app (Windows installer build)",
  "main": "main.js",
  "author": "TDQSYS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "assemble:server": "powershell -NoProfile -ExecutionPolicy Bypass -File assemble-server.ps1",
    "build:tts": "cd .. && python -m PyInstaller --onefile --name tts_server --clean --noconfirm --collect-data kokoro_onnx --collect-data language_tags --collect-all espeakng_loader --collect-all onnxruntime tts_server.py",
    "build:installer": "npm run assemble:server && npx electron-builder --win nsis",
    "build:portable": "npm run assemble:server && npx electron-builder --win portable",
    "build:all": "npm run assemble:server && npx electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tdqsys.queue.v2",
    "productName": "TDQSYS v2",
    "executableName": "tdqsys-v2",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "product.js",
      "icon.png",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "../dist/NiimbotPrinterDriverInstaller-3.0.2.1.exe",
        "to": "drivers/NiimbotPrinterDriverInstaller-3.0.2.1.exe"
      },
      {
        "from": "build/install-niimbot-driver.ps1",
        "to": "drivers/install-niimbot-driver.ps1"
      }
    ],
    "directories": {
      "output": "dist-v2-2.0.2-20261111"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app_icon.ico"
    },
    "portable": {
      "artifactName": "tdqsys-v2-portable-${version}.exe"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TDQSYS v2",
      "artifactName": "tdqsys-v2-setup-${version}.exe",
      "runAfterFinish": true
    }
  }
}
